KERNELS=="dpmac.12", ACTION=="add", RUN+="/bin/sh -c 'echo %k > /sys/class/leds/green:lan-12/device_name && echo 1 > /sys/class/leds/green:lan-12/link'"
KERNELS=="dpmac.13", ACTION=="add", RUN+="/bin/sh -c 'echo %k > /sys/class/leds/green:lan-20/device_name && echo 1 > /sys/class/leds/green:lan-20/link'"
