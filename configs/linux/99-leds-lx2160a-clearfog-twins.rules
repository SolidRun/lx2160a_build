KERNELS=="dpmac.16", ACTION=="add", RUN+="/bin/sh -c 'echo %k > /sys/class/leds/green:lan-14/device_name && echo 1 > /sys/class/leds/green:lan-14/link'"
KERNELS=="dpmac.17", ACTION=="add", RUN+="/bin/sh -c 'echo %k > /sys/class/leds/green:lan-10/device_name && echo 1 > /sys/class/leds/green:lan-10/link'"
KERNELS=="dpmac.18", ACTION=="add", RUN+="/bin/sh -c 'echo %k > /sys/class/leds/green:lan-16/device_name && echo 1 > /sys/class/leds/green:lan-16/link'"
LABEL="lx2160a_clearfog_twins_end"
