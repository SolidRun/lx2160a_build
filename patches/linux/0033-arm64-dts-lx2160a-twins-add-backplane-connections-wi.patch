From f564da83b6838705dee2f44461eff633d8fbeb57 Mon Sep 17 00:00:00 2001
From: Josua Mayer <josua@solid-run.com>
Date: Thu, 18 Jun 2026 12:13:35 +0200
Subject: [PATCH] arm64: dts: lx2160a-twins: add backplane connections with
 retimer

Signed-off-by: Josua Mayer <josua@solid-run.com>
---
 .../fsl-lx2160a-twins-backplane.dtsi          | 43 +++++++++++++++++++
 .../dts/freescale/fsl-lx2160a-twins-left.dts  |  1 +
 .../dts/freescale/fsl-lx2160a-twins-right.dts |  1 +
 .../boot/dts/freescale/fsl-lx2160a-twins.dtsi | 30 -------------
 4 files changed, 45 insertions(+), 30 deletions(-)
 create mode 100644 arch/arm64/boot/dts/freescale/fsl-lx2160a-twins-backplane.dtsi

diff --git a/arch/arm64/boot/dts/freescale/fsl-lx2160a-twins-backplane.dtsi b/arch/arm64/boot/dts/freescale/fsl-lx2160a-twins-backplane.dtsi
new file mode 100644
index 000000000000..5466d088b639
--- /dev/null
+++ b/arch/arm64/boot/dts/freescale/fsl-lx2160a-twins-backplane.dtsi
@@ -0,0 +1,43 @@
+// SPDX-License-Identifier: (GPL-2.0 OR MIT)
+//
+// Copyright 2026 SolidRun Ltd.
+
+&i2c_smb {
+	retimer: retimer@22 {
+		compatible = "ti,ds250df410";
+		reg = <0x22>;
+		#phy-cells = <1>;
+	};
+};
+
+/* backplane link with retimer */
+&dpmac5 {
+	phys = <&serdes_1 5>, <&retimer 1>, <&retimer 3>;
+	phy-names = "serdes", "retimer", "retimer";
+
+	/* retimer does not support c72 link training for backplane */
+	fixed-link {
+		speed = <10000>;
+		full-duplex;
+	};
+};
+
+/* backplane link with retimer */
+&dpmac6 {
+	phys = <&serdes_1 4>, <&retimer 0>, <&retimer 2>;
+	phy-names = "serdes", "retimer", "retimer";
+
+	/* retimer does not support c72 link training for backplane */
+	fixed-link {
+		speed = <10000>;
+		full-duplex;
+	};
+};
+
+&pcs_mdio5 {
+	status = "okay";
+};
+
+&pcs_mdio6 {
+	status = "okay";
+};
diff --git a/arch/arm64/boot/dts/freescale/fsl-lx2160a-twins-left.dts b/arch/arm64/boot/dts/freescale/fsl-lx2160a-twins-left.dts
index 2d019d3f131f..f097dc23a05f 100644
--- a/arch/arm64/boot/dts/freescale/fsl-lx2160a-twins-left.dts
+++ b/arch/arm64/boot/dts/freescale/fsl-lx2160a-twins-left.dts
@@ -9,6 +9,7 @@
 #include "fsl-lx2160a.dtsi"
 #include "fsl-lx2160a-cex7.dtsi"
 #include "fsl-lx2160a-twins.dtsi"
+#include "fsl-lx2160a-twins-backplane.dtsi"
 
 / {
 	compatible = "solidrun,twins-left", "solidrun,lx2160a-cex7", "fsl,lx2160a";
diff --git a/arch/arm64/boot/dts/freescale/fsl-lx2160a-twins-right.dts b/arch/arm64/boot/dts/freescale/fsl-lx2160a-twins-right.dts
index ab9d55976465..6597471a71bc 100644
--- a/arch/arm64/boot/dts/freescale/fsl-lx2160a-twins-right.dts
+++ b/arch/arm64/boot/dts/freescale/fsl-lx2160a-twins-right.dts
@@ -10,6 +10,7 @@
 #include "fsl-lx2160a-cex7.dtsi"
 #include "fsl-lx2160a-twins.dtsi"
 #include "fsl-lx2160a-twins-control.dtsi"
+#include "fsl-lx2160a-twins-backplane.dtsi"
 
 / {
 	compatible = "solidrun,twins-right", "solidrun,lx2160a-cex7", "fsl,lx2160a";
diff --git a/arch/arm64/boot/dts/freescale/fsl-lx2160a-twins.dtsi b/arch/arm64/boot/dts/freescale/fsl-lx2160a-twins.dtsi
index 17567c1f971c..a1450e8abbd0 100644
--- a/arch/arm64/boot/dts/freescale/fsl-lx2160a-twins.dtsi
+++ b/arch/arm64/boot/dts/freescale/fsl-lx2160a-twins.dtsi
@@ -324,24 +324,6 @@ &dpmac4 {
 	sfp = <&c1_bt_sfp>;
 };
 
-/* sfp port 1 */
-&dpmac5 {
-	managed = "in-band-status";
-	phys = <&serdes_1 5>;
-	status = "disabled";
-	/* twins assembly: sfp not connected (R692, R693, R694, R695, R682, R683, R684, R685) */
-	/* twins assembly: 10gkr with dual retimer */
-};
-
-/* sfp port 3 */
-&dpmac6 {
-	managed = "in-band-status";
-	phys = <&serdes_1 4>;
-	status = "disabled";
-	/* twins assembly: sfp not connected (R690, R691, R696, R697, R674, R675, R676, R677) */
-	/* twins assembly: 10gkr with dual retimer */
-};
-
 /* sfp port 15 */
 &dpmac7 {
 	managed = "in-band-status";
@@ -563,18 +545,6 @@ &pcs_mdio4 {
 	status = "okay";
 };
 
-&pcs_mdio5 {
-	status = "disabled";
-	/* twins assembly: sfp not connected (R692, R693, R694, R695, R682, R683, R684, R685) */
-	/* twins assembly: 10gkr with dual retimer */
-};
-
-&pcs_mdio6 {
-	status = "disabled";
-	/* twins assembly: sfp not connected (R690, R691, R696, R697, R674, R675, R676, R677) */
-	/* twins assembly: 10gkr with dual retimer */
-};
-
 &pcs_mdio7 {
 	status = "okay";
 };
-- 
