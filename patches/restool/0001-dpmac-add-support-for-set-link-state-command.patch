From 591378f33930ffedaafdd8555287555a41fc770e Mon Sep 17 00:00:00 2001
From: Josua Mayer <josua@solid-run.com>
Date: Tue, 26 May 2026 13:51:44 +0200
Subject: [PATCH] dpmac: add support for set link state command

Signed-off-by: Josua Mayer <josua@solid-run.com>
---
 dpmac_commands.c       | 189 +++++++++++++++++++++++++++++++++++++++++
 mc_v10/dpmac.c         |  32 +++++++
 mc_v10/fsl_dpmac.h     |  23 +++++
 mc_v10/fsl_dpmac_cmd.h |  20 +++++
 4 files changed, 264 insertions(+)

diff --git a/dpmac_commands.c b/dpmac_commands.c
index 3b300cb..9c71531 100644
--- a/dpmac_commands.c
+++ b/dpmac_commands.c
@@ -129,6 +129,65 @@ static struct option dpmac_destroy_options[] = {
 
 C_ASSERT(ARRAY_SIZE(dpmac_destroy_options) <= MAX_NUM_CMD_LINE_OPTIONS + 1);
 
+enum dpmac_link_options_v10 {
+	LINK_OPT_HELP = 0,
+	LINK_OPT_STATE,
+	LINK_OPT_FORCE_STATE,
+	LINK_OPT_RATE,
+	LINK_OPT_OPTIONS,
+	LINK_OPT_SUPPORTED,
+	LINK_OPT_ADVERTISING,
+};
+
+static struct option dpmac_link_options[] = {
+	[LINK_OPT_HELP] = {
+		.name = "help",
+		.has_arg = 0,
+		.flag = NULL,
+		.val = 0,
+	},
+	[LINK_OPT_STATE] = {
+		.name = "state",
+		.has_arg = 1,
+		.flag = NULL,
+		.val = 0,
+	},
+	[LINK_OPT_FORCE_STATE] = {
+		.name = "force",
+		.has_arg = 0,
+		.flag = NULL,
+		.val = 0,
+	},
+	[LINK_OPT_RATE] = {
+		.name = "rate",
+		.has_arg = 1,
+		.flag = NULL,
+		.val = 0,
+	},
+	[LINK_OPT_OPTIONS] = {
+		.name = "options",
+		.has_arg = 1,
+		.flag = NULL,
+		.val = 0,
+	},
+	[LINK_OPT_SUPPORTED] = {
+		.name = "supported",
+		.has_arg = 1,
+		.flag = NULL,
+		.val = 0,
+	},
+	[LINK_OPT_ADVERTISING] = {
+		.name = "advertising",
+		.has_arg = 1,
+		.flag = NULL,
+		.val = 0,
+	},
+
+	{ 0 },
+};
+
+C_ASSERT(ARRAY_SIZE(dpmac_link_options) <= MAX_NUM_CMD_LINE_OPTIONS + 1);
+
 const struct flib_ops dpmac_ops = {
 	.obj_open = dpmac_open_v10,
 	.obj_close = dpmac_close_v10,
@@ -145,6 +204,7 @@ static int cmd_dpmac_help(void)
 		"   info - displays detailed information about a DPMAC object.\n"
 		"   create - creates a new child DPMAC under the root DPRC.\n"
 		"   destroy - destroys a child DPMAC under the root DPRC.\n"
+		"   link - set DPMAC link state.\n"
 		"\n"
 		"For command-specific help, use the --help option of each command.\n"
 		"\n";
@@ -891,6 +951,131 @@ static int cmd_dpmac_destroy_v10(void)
 	return destroy_dpmac(MC_FW_VERSION_10);
 }
 
+static int link_dpmac_v10(const char *usage_msg)
+{
+	uint32_t dpmac_id;
+	uint16_t dpmac_handle;
+	int error;
+	bool dpmac_opened = false;
+	struct dpmac_link_state_v10 link_state;
+
+	if (restool.cmd_option_mask & ONE_BIT_MASK(INFO_OPT_HELP)) {
+		puts(usage_msg);
+		restool.cmd_option_mask &= ~ONE_BIT_MASK(INFO_OPT_HELP);
+		error = 0;
+		goto out;
+	}
+
+	if (restool.obj_name == NULL) {
+		ERROR_PRINTF("<object> argument missing\n");
+		puts(usage_msg);
+		error = -EINVAL;
+		goto out;
+	}
+
+	error = parse_object_name(restool.obj_name, "dpmac", &dpmac_id);
+	if (error < 0)
+		goto out;
+
+	error = dpmac_open(&restool.mc_io, 0, dpmac_id, &dpmac_handle);
+	if (error < 0) {
+		mc_status = flib_error_to_mc_status(error);
+		ERROR_PRINTF("MC error: %s (status %#x)\n",
+			     mc_status_to_string(mc_status), mc_status);
+		goto out;
+	}
+	dpmac_opened = true;
+	if (0 == dpmac_handle) {
+		DEBUG_PRINTF(
+			"dpmac_open() returned invalid handle (auth 0) for dpmac.%u\n",
+			dpmac_id);
+		error = -ENOENT;
+		goto out;
+	}
+
+	/* initialize link_state with defaults */
+	link_state.rate = 10000;
+	link_state.options = 0;
+	link_state.up = 0;
+	link_state.state_valid = 0;
+	link_state.supported = 0;
+	link_state.advertising = 0;
+
+	/* Override defaults with CLI arguments if provided */
+	if (restool.cmd_option_mask & ONE_BIT_MASK(LINK_OPT_STATE)) {
+		restool.cmd_option_mask &= ~ONE_BIT_MASK(LINK_OPT_STATE);
+		uint32_t optval = strtoul(restool.cmd_option_args[LINK_OPT_STATE], NULL, 0);
+		link_state.up = !!optval;
+	}
+	if (restool.cmd_option_mask & ONE_BIT_MASK(LINK_OPT_FORCE_STATE)) {
+		restool.cmd_option_mask &= ~ONE_BIT_MASK(LINK_OPT_FORCE_STATE);
+		link_state.state_valid = 1;
+	}
+	if (restool.cmd_option_mask & ONE_BIT_MASK(LINK_OPT_RATE)) {
+		restool.cmd_option_mask &= ~ONE_BIT_MASK(LINK_OPT_RATE);
+		uint32_t optval = strtoul(restool.cmd_option_args[LINK_OPT_RATE], NULL, 0);
+		link_state.rate = optval;
+	}
+	if (restool.cmd_option_mask & ONE_BIT_MASK(LINK_OPT_OPTIONS)) {
+		restool.cmd_option_mask &= ~ONE_BIT_MASK(LINK_OPT_OPTIONS);
+		uint64_t optval = strtoull(restool.cmd_option_args[LINK_OPT_OPTIONS], NULL, 0);
+		link_state.options = optval;
+	}
+	if (restool.cmd_option_mask & ONE_BIT_MASK(LINK_OPT_SUPPORTED)) {
+		restool.cmd_option_mask &= ~ONE_BIT_MASK(LINK_OPT_SUPPORTED);
+		uint64_t optval = strtoull(restool.cmd_option_args[LINK_OPT_SUPPORTED], NULL, 0);
+		link_state.supported = optval;
+	}
+	if (restool.cmd_option_mask & ONE_BIT_MASK(LINK_OPT_ADVERTISING)) {
+		restool.cmd_option_mask &= ~ONE_BIT_MASK(LINK_OPT_ADVERTISING);
+		uint64_t optval = strtoull(restool.cmd_option_args[LINK_OPT_ADVERTISING], NULL, 0);
+		link_state.advertising = optval;
+	}
+
+	error = dpmac_set_link_state_v10(&restool.mc_io, 0,
+					 dpmac_handle, &link_state);
+
+out:
+	if (dpmac_opened) {
+		int error2;
+
+		error2 = dpmac_close(&restool.mc_io, 0, dpmac_handle);
+		if (error2 < 0) {
+			mc_status = flib_error_to_mc_status(error2);
+			ERROR_PRINTF("MC error: %s (status %#x)\n",
+				     mc_status_to_string(mc_status), mc_status);
+			if (error == 0)
+				error = error2;
+		}
+	}
+
+	return error;
+}
+
+static int cmd_dpmac_link_v10(void)
+{
+	static const char usage_msg[] =
+		"\n"
+		"Usage: restool dpmac link dpmac.X\n"
+		"\n"
+		"OPTIONS:\n"
+		"--state=<0|1>\n"
+		"   Link state - 1 for up, 0 for down (default: 0)\n"
+		"--force\n"
+		"   Force link state\n"
+		"--rate=<number>\n"
+		"   Link rate in Mbps (default: 10000)\n"
+		"--options=<number>\n"
+		"   Link options bitmap (default: 0)\n"
+		"--supported=<number>\n"
+		"   Supported PHY speeds bitmap (default: 0)\n"
+		"--advertising=<number>\n"
+		"   Advertised speeds bitmap (default: 0)\n"
+		"\n";
+
+	return link_dpmac_v10(usage_msg);
+}
+
 struct object_command dpmac_commands_v9[] = {
 	{ .cmd_name = "--help",
 	  .options = NULL,
@@ -928,6 +1113,10 @@ struct object_command dpmac_commands_v10[] = {
 	  .options = dpmac_destroy_options,
 	  .cmd_func = cmd_dpmac_destroy_v10 },
 
+	{ .cmd_name = "link",
+	  .options = dpmac_link_options,
+	  .cmd_func = cmd_dpmac_link_v10 },
+
 	{ .cmd_name = NULL },
 };
 
diff --git a/mc_v10/dpmac.c b/mc_v10/dpmac.c
index b1ff609..4d19e8d 100644
--- a/mc_v10/dpmac.c
+++ b/mc_v10/dpmac.c
@@ -419,3 +419,35 @@ int dpmac_get_mac_addr_v10(struct fsl_mc_io *mc_io,
 	return 0;
 }
 
+/**
+ * dpmac_set_link_state() - Set the Ethernet link status
+ * @mc_io:	Pointer to opaque I/O object
+ * @cmd_flags:	Command flags; one or more of 'MC_CMD_FLAG_'
+ * @token:	Token of DPMAC object
+ * @link_state:	Link state configuration
+ *
+ * Return:	'0' on Success; Error code otherwise.
+ */
+int dpmac_set_link_state_v10(struct fsl_mc_io *mc_io,
+			     uint32_t cmd_flags,
+			     uint16_t token,
+			     struct dpmac_link_state_v10 *link_state)
+{
+	struct dpmac_cmd_set_link_state *cmd_params;
+	struct mc_command cmd = { 0 };
+
+	/* prepare command */
+	cmd.header = mc_encode_cmd_header(DPMAC_CMDID_SET_LINK_STATE,
+					  cmd_flags,
+					  token);
+	cmd_params = (struct dpmac_cmd_set_link_state *)cmd.params;
+	cmd_params->options = cpu_to_le64(link_state->options);
+	cmd_params->rate = cpu_to_le32(link_state->rate);
+	dpmac_set_field(cmd_params->up, STATE, link_state->up);
+	dpmac_set_field(cmd_params->up, STATE_VALID, link_state->state_valid);
+	cmd_params->supported = cpu_to_le64(link_state->supported);
+	cmd_params->advertising = cpu_to_le64(link_state->advertising);
+
+	/* send command to mc*/
+	return mc_send_command(mc_io, &cmd);
+}
diff --git a/mc_v10/fsl_dpmac.h b/mc_v10/fsl_dpmac.h
index c106a38..bcd2a31 100644
--- a/mc_v10/fsl_dpmac.h
+++ b/mc_v10/fsl_dpmac.h
@@ -108,4 +108,27 @@ int dpmac_get_api_version_v10(struct fsl_mc_io *mc_io,
 			      uint16_t *major_ver,
 			      uint16_t *minor_ver);
 
+/**
+ * struct dpmac_link_state - DPMAC link configuration request
+ * @rate: Rate in Mbps
+ * @options: Enable/Disable DPMAC link cfg features (bitmap)
+ * @up: Link state
+ * @state_valid: Ignore/Update the state of the link
+ * @supported: Speeds capability of the phy (bitmap)
+ * @advertising: Speeds that are advertised for autoneg (bitmap)
+ */
+struct dpmac_link_state_v10 {
+	uint32_t rate;
+	uint64_t options;
+	int up;
+	int state_valid;
+	uint64_t supported;
+	uint64_t advertising;
+};
+
+int dpmac_set_link_state_v10(struct fsl_mc_io *mc_io,
+			     uint32_t cmd_flags,
+			     uint16_t token,
+			     struct dpmac_link_state_v10 *link_state);
+
 #endif /* __FSL_DPMAC_H */
diff --git a/mc_v10/fsl_dpmac_cmd.h b/mc_v10/fsl_dpmac_cmd.h
index 2a6fd44..fe2d437 100644
--- a/mc_v10/fsl_dpmac_cmd.h
+++ b/mc_v10/fsl_dpmac_cmd.h
@@ -37,9 +37,11 @@
 #define DPMAC_VER_MAJOR			4
 #define DPMAC_VER_MINOR			2
 #define DPMAC_CMD_BASE_VERSION		1
+#define DPMAC_CMD_2ND_VERSION		2
 #define DPMAC_CMD_ID_OFFSET		4
 
 #define DPMAC_CMD(id)	(((id) << DPMAC_CMD_ID_OFFSET) | DPMAC_CMD_BASE_VERSION)
+#define DPMAC_CMD_V2(id) (((id) << DPMAC_CMD_ID_OFFSET) | DPMAC_CMD_2ND_VERSION)
 
 /* Command IDs */
 #define DPMAC_CMDID_CLOSE		DPMAC_CMD(0x800)
@@ -50,6 +52,7 @@
 #define DPMAC_CMDID_GET_ATTR		DPMAC_CMD(0x004)
 #define DPMAC_CMDID_GET_IRQ_MASK	DPMAC_CMD(0x015)
 #define DPMAC_CMDID_GET_IRQ_STATUS	DPMAC_CMD(0x016)
+#define DPMAC_CMDID_SET_LINK_STATE	DPMAC_CMD_V2(0x0c3)
 #define DPMAC_CMDID_GET_COUNTER		DPMAC_CMD(0x0c4)
 #define DPMAC_CMDID_GET_MAC_ADDR	DPMAC_CMD(0x0c5)
 
@@ -118,5 +121,22 @@ struct dpmac_rsp_get_mac_addr {
 	uint16_t pad;
 	uint8_t mac_addr[6];
 };
+
+#define DPMAC_STATE_SIZE	1
+#define DPMAC_STATE_SHIFT	0
+#define DPMAC_STATE_VALID_SIZE 		1
+#define DPMAC_STATE_VALID_SHIFT		1
+
+struct dpmac_cmd_set_link_state {
+	uint64_t  options;
+	uint32_t  rate;
+	uint32_t  pad;
+	/* only least significant bit is valid */
+	uint8_t  up;
+	uint8_t  pad0[7];
+	uint64_t supported;
+	uint64_t advertising;
+};
+
 #pragma pack(pop)
 #endif /* _FSL_DPMAC_CMD_H */
-- 
