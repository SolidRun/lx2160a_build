+++ b/config/lx2160a/CEX7/dpc-8_x_usxgmii.dts
@@ -48,13 +48,13 @@
 
 		log {
 			mode = "LOG_MODE_ON";
-			level = "LOG_LEVEL_WARNING";
+			level = "LOG_LEVEL_DEBUG";
 		};
 
 		console {
 			mode = "CONSOLE_MODE_OFF";
 			uart_id = <0x4>;
-			level = "LOG_LEVEL_WARNING";
