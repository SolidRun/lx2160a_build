From db77d16c22f79d1fddcdc49b77121bb70a0a1ac6 Mon Sep 17 00:00:00 2001
From: Josua Mayer <josua@solid-run.com>
Date: Thu, 26 Nov 2026 16:34:58 +0100
Subject: [PATCH 49/49] board: lx2160acex7: increase environment size to 64k,
 enable redundant

LX2160A default environment variabels set at compile-time are already
6kB. The 64M SPI flash layout allocates 128k, and the 4M layout 64k.

Both spi flashes used for solidrun lx2160a products, MT35xU512, and
W25Q32 support smaller 4k subsector erase commands.

Increase environment size to 64k, and enable redundant environment on
the 64M layout to utilise the full allocated 128k area.

Signed-off-by: Josua Mayer <josua@solid-run.com>
---
 board/solidrun/lx2160acex7/Kconfig | 12 ++++++++----
 configs/lx2160acex7_tfa_defconfig  |  2 --
 2 files changed, 8 insertions(+), 6 deletions(-)

diff --git a/board/solidrun/lx2160acex7/Kconfig b/board/solidrun/lx2160acex7/Kconfig
index 6118f93123f..308db43d0e6 100644
--- a/board/solidrun/lx2160acex7/Kconfig
+++ b/board/solidrun/lx2160acex7/Kconfig
@@ -35,12 +35,16 @@ config ENV_OFFSET
 	default 0x1F0000 if LX2160ACEX7_BOOTMEDIA_4M
 
 config ENV_SIZE
-	default 0x40000 if LX2160ACEX7_BOOTMEDIA_64M
-	default 0x2000 if LX2160ACEX7_BOOTMEDIA_4M
+	default 0x10000
 
 config ENV_SECT_SIZE
-	default 0x20000 if LX2160ACEX7_BOOTMEDIA_64M
-	default 0x10000 if LX2160ACEX7_BOOTMEDIA_4M
+	default 0x10000
+
+config SYS_REDUNDAND_ENVIRONMENT
+	default y if LX2160ACEX7_BOOTMEDIA_64M
+
+config ENV_OFFSET_REDUND
+	default 0x510000 if LX2160ACEX7_BOOTMEDIA_64M
 
 config LX2160ACEX7_XSPI_SWAPPED_CS
 	bool "XSPI Chip-Select 0/1 are swapped"
diff --git a/configs/lx2160acex7_tfa_defconfig b/configs/lx2160acex7_tfa_defconfig
index c1f39b6c5f7..09905ee7fbb 100644
--- a/configs/lx2160acex7_tfa_defconfig
+++ b/configs/lx2160acex7_tfa_defconfig
@@ -7,7 +7,6 @@ CONFIG_TEXT_BASE=0x82000000
 CONFIG_SYS_MALLOC_LEN=0x202000
 CONFIG_SYS_MALLOC_F_LEN=0x6000
 CONFIG_NR_DRAM_BANKS=3
-CONFIG_ENV_SIZE=0x2000
 CONFIG_DM_GPIO=y
 CONFIG_DEFAULT_DEVICE_TREE="fsl-lx2160a-cex7"
 CONFIG_FSPI_AHB_EN_4BYTE=y
@@ -73,7 +72,6 @@ CONFIG_DM_SPI_FLASH=y
 CONFIG_SPI_FLASH_STMICRO=y
 CONFIG_SPI_FLASH_MT35XU=y
 CONFIG_SPI_FLASH_WINBOND=y
-# CONFIG_SPI_FLASH_USE_4K_SECTORS is not set
 CONFIG_PHYLIB=y
 CONFIG_PHY_AQUANTIA=y
 CONFIG_PHY_ATHEROS=y
-- 
